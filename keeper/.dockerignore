# Keep the Docker build context lean + keep secrets out of it. The Dockerfile COPYs
# package.json, pnpm-lock.yaml, src/, tsconfig.json and gasWatchdog.mjs — everything below is either
# a secret, a local artifact, or host-only tooling that must never enter the image or build context.
node_modules
.env
.env.*
coverage
test
*.md
*.mjs
# ...but the gas-watchdog DOES ship in the image (the supervised gas self-heal service needs it).
!gasWatchdog.mjs
ecosystem.config.cjs
deploy
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
