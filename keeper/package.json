{
  "name": "fee-arena-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous off-chain keeper that drives the Fee Arena epoch lifecycle (create/open/start/end/sweep/finalize) per market.",
  "scripts": {
    "start": "tsx src/index.ts",
    "arb": "tsx src/arb.ts",
    "swapbot": "tsx src/swapbot.ts",
    "stakerbot": "tsx src/stakerbot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "viem": "2.19.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vitest": "2.0.5",
    "@vitest/coverage-v8": "2.0.5"
  },
  "packageManager": "pnpm@9.6.0"
}
