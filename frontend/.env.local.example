# OPTIONAL: FeeArena deploy block - lower bound for epoch-history/leaderboard getLogs (default 0).
# Only used in single-market mode (no NEXT_PUBLIC_MARKETS). When NEXT_PUBLIC_MARKETS is set,
# each market entry must carry its own "fromBlock" field - this key is ignored.
# NEXT_PUBLIC_FEE_ARENA_FROM_BLOCK=0
#
# Multi-market example (ETH + BTC) with per-market fromBlock (required for scan performance):
# NEXT_PUBLIC_MARKETS=[{"id":"eth","label":"ETH / USDC","baseSymbol":"WETH","baseDecimals":18,"feeArena":"0x2df700Fb55f2340556B1fdB062D417a13c836b19","oracle":"0x06bf63D58B9328A6912fB737aE30c0ED00e286Ae","pool":"0xf6D3BF91EfC02A2F77ec6fAA38681b88fF156881","feedId":"0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace","fromBlock":45683739},{"id":"btc","label":"BTC / USDC","baseSymbol":"WBTC","baseDecimals":8,"feeArena":"0x0000000000000000000000000000000000000000","oracle":"0x0000000000000000000000000000000000000000","pool":"0x0000000000000000000000000000000000000000","feedId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","fromBlock":45683973}]

# ── Circle Programmable Wallets (user-controlled embedded wallets) ──────────────────
# App ID from the Circle Console (Wallets → User Controlled → Configurator). PUBLIC / client-safe.
NEXT_PUBLIC_CIRCLE_APP_ID=66dd9e79-4802-52f0-9da0-c7058a853d5d
# Circle API key (the whole "TEST_API_KEY:<id>:<secret>" string). SERVER-ONLY - used by /api/circle/*
# route handlers via process.env.CIRCLE_API_KEY. NEVER prefix with NEXT_PUBLIC_ (it would leak the key).
# CIRCLE_API_KEY=TEST_API_KEY:xxxxxxxx:yyyyyyyy
# Google OAuth Client ID for "Continue with Google" wallet login (PUBLIC / client-safe). Same client ID
# you registered in the Circle Console + Google Cloud (authorized JS origin = your site origin). Empty = Google hidden.
# NEXT_PUBLIC_CIRCLE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
