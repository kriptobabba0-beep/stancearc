# ──────────────────────────────────────────────────────────────────────────────
# Limen Finance V0 - frontend environment (NEXT_PUBLIC_* only; chain is the only
# data source, no backend secrets). Copy to .env.local and fill the ADDRESS
# keys from the contracts Deploy script output (see README "Wiring addresses").
# Validated at boot by lib/env.ts - the app HARD-FAILS on a missing/invalid key.
# ──────────────────────────────────────────────────────────────────────────────

# Arc Testnet chain id (must equal 5042002; app refuses to run otherwise).
NEXT_PUBLIC_CHAIN_ID=5042002

# RPC endpoints (HTTP + WebSocket). WS powers the event-watch optimization;
# the app stays correct on HTTP polling alone if WS is unavailable.
#
# NEXT_PUBLIC_RPC_HTTP accepts a COMMA-SEPARATED list of Arc http(s) RPC URLs.
# The first URL is primary; the rest are fallbacks tried in order by viem's fallback()
# transport, so one provider outage does not degrade the app.  A single URL also works.
# Example (primary + two fallbacks):
#   NEXT_PUBLIC_RPC_HTTP=https://rpc1.arc.network,https://rpc2.arc.network,https://rpc3.arc.network
NEXT_PUBLIC_RPC_HTTP=https://rpc.testnet.arc.network
NEXT_PUBLIC_RPC_WS=wss://rpc.testnet.arc.network

# Block explorer base URL (used for tx + address links).
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app

# ── Deployed contract addresses - FILL FROM THE CONTRACTS DEPLOY OUTPUT ──────
# After running `make deploy-demo` at the repo root (or `forge script
# script/Deploy.s.sol`), the addresses are printed to the console and saved to
# broadcast/Deploy.s.sol/5042002/run-latest.json. Copy each value here.
NEXT_PUBLIC_FEE_ARENA_ADDRESS=0xD0aEDc19E1C27E7643255432006942ccFba5B8CE
# OPTIONAL: FeeArena deploy block - lower bound for the epoch-history / leaderboard getLogs
# backfill. Set to the deploy block to skip scanning empty pre-deploy ranges (default 0).
# NEXT_PUBLIC_FEE_ARENA_FROM_BLOCK=0
NEXT_PUBLIC_ORACLE_ADDRESS=0xeC6214cB521D4C7178B8CDEfaEf76e5b021Dde59
NEXT_PUBLIC_NPM_ADDRESS=0x646E3cCd584b315F235aD269C0893a125D9F38dc
NEXT_PUBLIC_FACTORY_ADDRESS=0x184b90622535b024AD178730f39b75D26EF04826
NEXT_PUBLIC_POOL_ADDRESS=0x969f2e3CB9929b5D50B6A59Cf49CF30870e1658b
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=0x7fcEF1330B4C21f884D6894f3d6a56036E587aA9

# ── Token addresses ───────────────────────────────────────────────────────────
# ERC-20 USDC on Arc testnet is canonical (6 decimals, hard-asserted at boot).
# This is NOT the 18-dp native USDC gas token (that is shown only as a labeled
# "USDC (gas)" balance and never used in token math).
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Circle EURC (euro stablecoin) on Arc testnet - 6 decimals, faucet at faucet.circle.com.
# OPTIONAL: defaults to the canonical Arc address below if unset (verified on-chain: code present,
# decimals()=6, symbol()="EURC"). Override only if Circle redeploys EURC on Arc.
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# WETH9-style test token deployed by the Deploy script (18 decimals).
# Fill from Deploy output: "WETH9 test token" -> NEXT_PUBLIC_WETH_ADDRESS
NEXT_PUBLIC_WETH_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF

# Canonical Multicall3 - same address on every chain; batches per-position reads.
NEXT_PUBLIC_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# Arena pool fee tier (uint24). 3000 == 0.3%. Optional; defaults to 3000.
# Must match the fee tier used when the Uniswap V3 pool was created by Deploy.s.sol.
NEXT_PUBLIC_FEE_TIER=3000

# Active markets - the LIVE cirBTC/USDC FeeArena **v1** arena (the product users stake on today),
# plus the deployed FeeArena **v2** (conviction-parimutuel) arena as a SECONDARY entry.
# Set here (not just in .env.local) so the boot gate AND the CI e2e build (frontend-ci copies this
# file to .env.local) target them. baseDecimals MUST be 8 (cirBTC) or the decimals gate hard-fails.
#
# ── CUTOVER-SAFETY: KEEP THE LIVE v1 MARKET FIRST (v1-first) ──────────────────────────────────
# lib/markets.ts sets DEFAULT_MARKET_ID = MARKETS[0].id, so whichever market is listed FIRST is the
# one the live product opens on by default. The v2 arena is DEPLOYED but NOT yet cranking - listing
# it first would default (and a Vercel env resync would point) the live product at an idle, un-cranked
# arena. So the live v1 market is listed FIRST and stays the default; v2 is reachable as a secondary
# entry so it can be cranked + verified.
#
# IMPORTANT FOR VERCEL: NEXT_PUBLIC_MARKETS in the Vercel project env MUST keep the LIVE entry-anchored
# v3 market at index 0 (it is the cranking product). Do NOT reorder the shelved v2 conviction preview
# to the front there. (The test test/envExampleCutover.test.ts fails loudly if this ordering regresses.)
#
# v2 entries MUST carry: "version":"v2", "lens" (FeeArenaV2Lens read/preview surface), "treasury"
# (burn sink for losing conviction), and conviction bounds "minConv"/"maxConv" in USDC 6dp base
# units (minConv=100 USDC=100000000, maxConv=1000 USDC=1000000000).
NEXT_PUBLIC_MARKETS=[{"id":"btc","label":"cirBTC / USDC","baseSymbol":"cirBTC","baseDecimals":8,"version":"v3","feeArena":"0xfbc6558ca71fefcbc08b394740a86dc654a8f3e2","oracle":"0xeC6214cB521D4C7178B8CDEfaEf76e5b021Dde59","pool":"0x969f2e3CB9929b5D50B6A59Cf49CF30870e1658b","feedId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","fromBlock":48684148,"acquireMode":"faucet","priceLabel":"BTC / USD"},{"id":"cirbtc-eurc","label":"cirBTC / EURC","baseSymbol":"cirBTC","baseDecimals":8,"quoteSymbol":"EURC","version":"v3","feeArena":"0xC7b0D0dd6D53BAA478BC1389863E2F2eb3EC6570","oracle":"0x7c16005A5aaFb04e78b4b830540Dd9c4158d742d","pool":"0xEBCc92862e007220A90b407f92E90dAC3A98aD63","feedId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","quoteFeedId":"0xa995d00bb36a63cef7fd2c287dc105fc8f3d93779f062f09551b0af3e81ec30b","fromBlock":47670000,"acquireMode":"faucet","priceLabel":"BTC / EUR"},{"id":"btc-v2","label":"BTC / USDC (v2 conviction \u2014 preview)","baseSymbol":"cirBTC","baseDecimals":8,"version":"v2","feeArena":"0xAEB33D3bfd63e4C330bb78A0a0b249e53DAA5C68","lens":"0xa0Db836f8a24781b5a4F457924C9860Dfe2a80b9","oracle":"0xF8ac3C46A062acC1d4c1BA23158bD0EF7242688E","pool":"0x969f2e3CB9929b5D50B6A59Cf49CF30870e1658b","treasury":"0x891bbabB7d9ab43aBDb2cEE2a24A25C97D80eFFE","minConv":"100000000","maxConv":"1000000000","feedId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","fromBlock":46043000,"acquireMode":"faucet","priceLabel":"BTC / USD"}]

# ── Pyth pull-oracle (V1: trustless) ──────────────────────────────────────────
# The FeeArena oracle (NEXT_PUBLIC_ORACLE_ADDRESS) is now a PythPriceOracle that
# reads from the Pyth contract below. The admin posts a SIGNED price update fetched
# from Hermes (and pays the Pyth update fee) when calling startEpoch/endEpoch.
#
# Pyth contract on Arc testnet (getUpdateFee / updatePriceFeeds / getPriceUnsafe).
NEXT_PUBLIC_PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
# 32-byte Pyth price-feed id for ETH/USD (same on every chain).
NEXT_PUBLIC_PYTH_ETHUSD_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43
# Hermes endpoint serving signed Pyth updates. Optional; defaults to the value below.
NEXT_PUBLIC_HERMES_URL=https://hermes.pyth.network

# ── Sentry error monitoring (OPTIONAL) ───────────────────────────────────────
# Both keys are OPTIONAL. The app builds and runs without them.
# Set NEXT_PUBLIC_SENTRY_DSN to activate error reporting (get it from
# sentry.io → Settings → Projects → <project> → Client Keys (DSN)).
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
#
# Set SENTRY_AUTH_TOKEN in CI / Vercel environment vars to upload source maps
# so stack traces in Sentry show original TypeScript line numbers.
# Generate at sentry.io → Settings → Auth Tokens.
# SENTRY_AUTH_TOKEN=sntrys_...
#
# Also set these in CI / Vercel if you want source-map upload:
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=your-sentry-project-slug

# ── Multi-market config (OPTIONAL) ───────────────────────────────────────────
# A JSON array of independent markets, each its own FeeArena + PythPriceOracle + V3 pool, with its
# own base token (symbol + decimals) and Pyth feed id. The shared infra above (USDC, V3 router/NPM,
# factory, Multicall3, Pyth contract, Hermes) stays GLOBAL across markets.
#
# When set, the dashboard shows a market selector and ALL reads/writes target the active market.
# When OMITTED (empty), the app falls back to a single ETH market built from the keys above
# (FEE_ARENA/ORACLE/POOL addresses + PYTH_ETHUSD_ID, baseSymbol "WETH", baseDecimals 18) - i.e.
# today's single-market behavior is unchanged.
#
# Each entry: { id, label, baseSymbol, baseDecimals, feeArena, oracle, pool, feedId, fromBlock,
#               version?, lens?, treasury?, minConv?, maxConv?, readOnly? }.
#   version    - "v1" (default) or "v2". A "v2" entry binds the FeeArenaV2 ABI (conviction stake) and
#                REQUIRES lens + treasury + minConv + maxConv (validated at boot).
#   lens       - FeeArenaV2Lens address. The frontend reads previewClaim/previewRefund/getStake(sByEpoch)
#                from the Lens, NOT the arena. Required + only meaningful for v2.
#   treasury   - burn sink for losing-side conviction (v2). Required for v2.
#   minConv / maxConv - conviction bounds in USDC 6dp base units (e.g. 100 USDC -> "100000000").
#                Required for v2; minConv must be > 0 and <= maxConv.
#   readOnly   - true marks a deprecated arena reachable for claims/unstakes only (new staking blocked
#                in the UI). Used for the cutover legacy v1 entry. Default false.
#   fromBlock  - REQUIRED for performance: the block at which this market's FeeArena was deployed.
#                Bounds the epoch-history / leaderboard getLogs backfill so the app only scans
#                blocks from the deploy onward. Without it the scan starts at block 0, triggering
#                hundreds of sequential (now parallel-batched) RPC calls on Arc's fast blocks.
#                NOTE: NEXT_PUBLIC_FEE_ARENA_FROM_BLOCK does NOT apply when NEXT_PUBLIC_MARKETS is
#                set - each market entry must carry its own fromBlock.
# Fill feeArena/oracle/pool from each market's Deploy output; feedId is the Pyth price-feed id.
# Example (ETH + BTC, live deploy blocks on Arc testnet) - single line, no surrounding quotes:
# NEXT_PUBLIC_MARKETS=[{"id":"eth","label":"ETH / USDC","baseSymbol":"WETH","baseDecimals":18,"feeArena":"0xb9759858DD83658779Fb9E8CA113DCBd605Eea08","oracle":"0xC64570d9076CC0c9302349D8E012A7e176d9cCC7","pool":"0x7999406650623D8350f9cf6a6dEcB61174678f34","feedId":"0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace","fromBlock":45967455},{"id":"btc","label":"BTC / USDC","baseSymbol":"WBTC","baseDecimals":8,"feeArena":"0x54e55d971F431ce858b058c5F1C1693C42fc2d5B","oracle":"0x4f12ED45d8D7E1a08d87297187497b1b849BFD08","pool":"0xFd958226fADE1D9594be683fC7e5d7184A4b0F2F","feedId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","fromBlock":45967552}]

# ── Circle Programmable Wallets (user-controlled embedded wallets) ──────────────────
# App ID from the Circle Console (Wallets → User Controlled → Configurator). PUBLIC / client-safe.
NEXT_PUBLIC_CIRCLE_APP_ID=66dd9e79-4802-52f0-9da0-c7058a853d5d
# Circle API key (the whole "TEST_API_KEY:<id>:<secret>" string). SERVER-ONLY - used by /api/circle/*
# route handlers via process.env.CIRCLE_API_KEY. NEVER prefix with NEXT_PUBLIC_ (it would leak the key).
# CIRCLE_API_KEY=TEST_API_KEY:xxxxxxxx:yyyyyyyy
# Google OAuth Client ID for "Continue with Google" wallet login (PUBLIC / client-safe). Same client ID
# you registered in the Circle Console + Google Cloud (authorized JS origin = your site origin). Empty = Google hidden.
# NEXT_PUBLIC_CIRCLE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
